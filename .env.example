# Server-Side Secrets (Never exposed to frontend/browser)
SUPER_ADMIN_PIN=8899

# Firebase Configuration (Required for Web Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-Side Gemini API Key (Optional for AI backend features)
GEMINI_API_KEY=your_gemini_api_key

# Hosting Application URL
APP_URL=your_app_url

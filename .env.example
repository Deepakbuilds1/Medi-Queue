# Server-Side Secrets (Never exposed to frontend/browser)
SUPER_ADMIN_PIN=8303

# ImageKit Configuration (Server-Side Integration)
# Private key must NEVER be exposed to browser/client-side code
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Firebase Configuration (Required for Web Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-Side Gemini API Key (Optional for AI backend features)
GEMINI_API_KEY=your_gemini_api_key

# Hosting Application URL
APP_URL=your_app_url

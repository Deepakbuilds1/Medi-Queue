rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Helper Functions for RBAC & Multi-Tenant Isolation
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin check: Custom Claims first, then fallback to authoritative user doc
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['SUPER_ADMIN', 'super_admin'] ||
        request.auth.token.isSuperAdmin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'super_admin']
        )
      );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the signed-in user belongs to or has access to the clinicId
    function isUserInClinic(clinicId) {
      return isSuperAdmin() || (
        request.auth.token.clinicId == clinicId ||
        (
          hasUserDoc() && (
            getUserData().clinicId == clinicId ||
            ('clinicIds' in getUserData() && clinicId in getUserData().clinicIds) ||
            ('accessibleClinicIds' in getUserData() && clinicId in getUserData().accessibleClinicIds)
          )
        )
      );
    }

    // Clinic Staff: Super Admin, Clinic Admin, Doctor, Receptionist assigned to the tenant
    function isClinicStaff(clinicId) {
      return isSuperAdmin() || (
        isUserInClinic(clinicId) && (
          request.auth.token.role in ['CLINIC_ADMIN', 'clinic_admin', 'admin', 'DOCTOR', 'RECEPTIONIST'] ||
          (
            hasUserDoc() &&
            getUserData().role in ['SUPER_ADMIN', 'CLINIC_ADMIN', 'clinic_admin', 'admin', 'DOCTOR', 'RECEPTIONIST']
          )
        )
      );
    }

    // Clinic Admin: Super Admin or Tenant Admin
    function isClinicAdmin(clinicId) {
      return isSuperAdmin() || (
        isUserInClinic(clinicId) && (
          request.auth.token.role in ['CLINIC_ADMIN', 'clinic_admin', 'admin'] ||
          request.auth.token.admin == true ||
          (
            hasUserDoc() &&
            getUserData().role in ['SUPER_ADMIN', 'CLINIC_ADMIN', 'clinic_admin', 'admin']
          )
        )
      );
    }

    // -------------------------------------------------------------
    // 1. Clinics Collection & Isolated Tenant Subcollections
    // -------------------------------------------------------------
    match /clinics/{clinicId} {
      // Clinic profile metadata is publicly readable for patient portal & TV display
      allow read: if true;
      
      // Only Super Admin can create or delete clinics; Clinic Admin can update their clinic
      allow create, delete: if isSuperAdmin();
      allow update: if isClinicAdmin(clinicId);

      // --- Tokens Subcollection: /clinics/{clinicId}/tokens/{tokenId} ---
      match /tokens/{tokenId} {
        // Publicly readable for Patient Queue boards & live status checks
        allow read: if true;
        
        // Anyone (patient or receptionist or self-service kiosk) can generate a queue token
        allow create: if true;
        
        // Staff of this clinic or the patient owner who booked the token can update
        allow update: if isClinicStaff(clinicId) || (
          isSignedIn() && 
          resource.data.userId == request.auth.uid
        );
        
        // Only Clinic Staff or Super Admin can delete/cancel tokens
        allow delete: if isClinicStaff(clinicId);
      }

      // --- Doctors Subcollection: /clinics/{clinicId}/doctors/{doctorId} ---
      match /doctors/{doctorId} {
        // Publicly readable for patient booking & room assignment displays
        allow read: if true;
        
        // Only Clinic Staff or Super Admin can manage doctors for this tenant
        allow write: if isClinicStaff(clinicId);
      }

      // --- Patients Subcollection: /clinics/{clinicId}/patients/{patientId} ---
      match /patients/{patientId} {
        // Clinic staff can read all patients; Patients can only read their own record
        allow read: if isClinicStaff(clinicId) || (
          isSignedIn() && (
            (resource.data.userId == request.auth.uid) ||
            (request.auth.uid == patientId)
          )
        );
        
        // Clinic staff or registered patients can create patient records
        allow create: if isClinicStaff(clinicId) || isSignedIn();
        
        // Clinic staff or the patient owner can update their info
        allow update: if isClinicStaff(clinicId) || (
          isSignedIn() && (
            (resource.data.userId == request.auth.uid) ||
            (request.auth.uid == patientId)
          )
        );
        
        // Only Clinic Staff or Super Admin can delete patient records
        allow delete: if isClinicStaff(clinicId);
      }

      // --- Staff Subcollection: /clinics/{clinicId}/staff/{staffId} ---
      match /staff/{staffId} {
        allow read: if isClinicStaff(clinicId);
        allow write: if isClinicAdmin(clinicId);
      }

      // --- Settings Subcollection: /clinics/{clinicId}/settings/{settingId} ---
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isClinicAdmin(clinicId);
      }

      // --- Counters Subcollection: /clinics/{clinicId}/counters/{counterId} ---
      match /counters/{counterId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------
    // 2. Global Users Collection: /users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      // 1. Signed-in user can ALWAYS read their own profile (immediate, non-circular!)
      // 2. Super Admin can read all user profiles
      // 3. Clinic Staff can read profiles of patients or staff assigned to their clinic
      allow read: if isOwner(userId) || isSuperAdmin() || (
        isSignedIn() && resource.data.clinicId != null && isClinicStaff(resource.data.clinicId)
      );

      // Super Admin can create any profile;
      // Authenticated user can create their own profile as PATIENT
      allow create: if isSuperAdmin() || (
        isOwner(userId) && 
        request.resource.data.role in ['PATIENT', 'patient']
      );

      // Super Admin can update any profile;
      // User can update their own profile provided they do NOT elevate their role or clinicId;
      // Clinic Admin can update staff/patient profiles assigned to their clinic (cannot grant SUPER_ADMIN)
      allow update: if isSuperAdmin() || (
        isOwner(userId) && 
        request.resource.data.role == resource.data.role &&
        (!('clinicId' in request.resource.data) || request.resource.data.clinicId == resource.data.clinicId) &&
        (!('clinicIds' in request.resource.data) || request.resource.data.clinicIds == resource.data.clinicIds) &&
        (!('accessibleClinicIds' in request.resource.data) || request.resource.data.accessibleClinicIds == resource.data.accessibleClinicIds)
      ) || (
        isSignedIn() && resource.data.clinicId != null && isClinicAdmin(resource.data.clinicId) &&
        request.resource.data.role in ['CLINIC_ADMIN', 'admin', 'DOCTOR', 'RECEPTIONIST', 'PATIENT', 'patient']
      );

      // Only Super Admin can delete users
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // 3. Global Audit Logs Collection: /auditLogs/{logId}
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      // Super Admin has authorized global access; Clinic staff can only read logs scoped to their authorized clinic
      allow read: if isSuperAdmin() || (
        isSignedIn() && resource.data.clinicId != null && isClinicStaff(resource.data.clinicId)
      );
      // Only authenticated users or Super Admin can create audit records
      allow create: if isSuperAdmin() || isSignedIn();
      // Only Super Admin can update or purge audit logs
      allow update, delete: if isSuperAdmin();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Clinic Logos:
    // Read: Public (needed for patient portal, public display screen, and receipts)
    // Write: Super Admin or Clinic Admin of that specific clinicId
    // Content type restricted to standard image formats, max size 5MB
    match /clinicLogos/{clinicId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role in ['SUPER_ADMIN', 'super_admin'] ||
        request.auth.token.isSuperAdmin == true ||
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'super_admin']
        ) ||
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['CLINIC_ADMIN', 'clinic_admin', 'admin'] &&
          (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.clinicId == clinicId ||
            clinicId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.clinicIds ||
            clinicId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accessibleClinicIds
          )
        )
      ) &&
      request.resource.size < 5 * 1024 * 1024 &&
      request.resource.contentType.matches('image/.*');
    }
  }
}
